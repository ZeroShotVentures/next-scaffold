# Validated at build and startup by src/env.ts. Set SKIP_ENV_VALIDATION=1 to bypass.

DATABASE_URL="postgresql://my-app:my-app@localhost:5432/my-app?schema=public"

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Billing (Stripe subscriptions). When true, the Stripe variables below are required.
# Read "Enabling billing on an existing app" in the README before turning this on for an app with users.
BILLING_ENABLED="false"

# https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=""
# Printed by: stripe listen --forward-to localhost:3000/api/auth/stripe/webhook
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_BASIC_MONTHLY=""
STRIPE_PRICE_BASIC_ANNUAL=""
STRIPE_PRICE_PRO_MONTHLY=""
STRIPE_PRICE_PRO_ANNUAL=""
